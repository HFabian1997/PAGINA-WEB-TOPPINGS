# content.json guarda la clave de administrador — nunca debe poder leerse
# directamente por la web; solo content.php (con sesión) lo usa.
<Files "content.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>
