# ============================================================
# NO subir a GitHub — el repositorio es público
# ============================================================

# Contraseña del admin y PIN de empleados (campos "adminSecret" y "pin")
admin/content.json

# Clave de la API de IA
api/ai-config.php

# Clave de servicio (api/push-config.php). Sí viaja en el despliegue —igual que
# ai-config.php— pero NUNCA a GitHub, que es público.
api/push-config.php

# Datos reales de clientes: nombres, puntajes, códigos de premio,
# reclamos del día. No es código, es información de personas.
api/data/*.json

# Fotos que suben los clientes (retos, stikers)
api/uploads/*
!api/uploads/.htaccess

# Lo de Claude Code: se ignora la carpeta, MENOS el guardado automático.
# Esos tres archivos sí tienen que viajar: si se clona el repo en otra
# computadora y no están, se deja de guardar solo y no se nota hasta que
# ya se perdieron días de trabajo.
.claude/*
!.claude/settings.json
!.claude/auto-guardar.sh
!.claude/auto-subir.sh

# Respaldos y archivos de trabajo
toppings_*.zip
RESTAURAR_*.zip
